# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for privileged writes (AI-generated rows). Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build OAuth / email redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (recommendation + roadmap on Opus 4.8, advisor on Haiku 4.5). Server-only.
ANTHROPIC_API_KEY=your-anthropic-key
